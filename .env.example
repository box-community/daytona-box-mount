# Create at https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# Optional: defaults to Daytona Cloud and your account's default region/snapshot
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# DAYTONA_SNAPSHOT=your-snapshot-name

# Host-only short-lived token from the Box Developer Console (demo use only).
# Run npm run secrets:sync after setting or rotating it. Sandboxes receive
# the Daytona secret box-mount-token as a placeholder, never this value.
BOX_ACCESS_TOKEN=
BOX_FOLDER_ID=

# Optional: assign a Box review task on the generated file
BOX_REVIEWER_USER_ID=

# Required: powers the autonomous contract-review agent
OPENAI_API_KEY=
# Optional: defaults to gpt-5.5
OPENAI_MODEL=gpt-5.5

# Optional when private/ contains exactly one .tar.gz or .tgz archive
# BOX_MOUNT_ARCHIVE=./private/your-box-mount-build.tar.gz
